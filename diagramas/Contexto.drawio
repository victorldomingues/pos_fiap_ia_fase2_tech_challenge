        <mxCell id="Sv29tqhT6_8t-wbLHTO0-57" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;fontSize=17;fontColor=#1A1A1A;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;VRP&lt;/h1&gt;&lt;ol class=&quot;code-line&quot; dir=&quot;auto&quot; style=&quot;margin-top: 0px; margin-bottom: 0.7em; font-family: -apple-system, &amp;quot;system-ui&amp;quot;, &amp;quot;Segoe WPC&amp;quot;, &amp;quot;Segoe UI&amp;quot;, system-ui, Ubuntu, &amp;quot;Droid Sans&amp;quot;, sans-serif; font-size: 14px;&quot;&gt;&lt;li class=&quot;code-line&quot; dir=&quot;auto&quot;&gt;&lt;code style=&quot;font-family: Menlo, Monaco, &amp;quot;Courier New&amp;quot;, monospace; background-color: rgba(255, 255, 255, 0.1); padding: 1px 3px; border-radius: 4px; font-size: 1em; line-height: 1.357em;&quot;&gt;data_loader.py&lt;/code&gt;: carrega hospitais, matriz e frota.&lt;/li&gt;&lt;li class=&quot;code-line&quot; dir=&quot;auto&quot;&gt;&lt;code style=&quot;font-family: Menlo, Monaco, &amp;quot;Courier New&amp;quot;, monospace; background-color: rgba(255, 255, 255, 0.1); padding: 1px 3px; border-radius: 4px; font-size: 1em; line-height: 1.357em;&quot;&gt;distance_matrix.py&lt;/code&gt;: monta matrizes de custo.&lt;/li&gt;&lt;li class=&quot;code-line&quot; dir=&quot;auto&quot;&gt;&lt;code style=&quot;font-family: Menlo, Monaco, &amp;quot;Courier New&amp;quot;, monospace; background-color: rgba(255, 255, 255, 0.1); padding: 1px 3px; border-radius: 4px; font-size: 1em; line-height: 1.357em;&quot;&gt;vrp.py&lt;/code&gt;: aplica restrições e calcula fitness.&lt;/li&gt;&lt;li class=&quot;code-line&quot; dir=&quot;auto&quot;&gt;&lt;code style=&quot;font-family: Menlo, Monaco, &amp;quot;Courier New&amp;quot;, monospace; background-color: rgba(255, 255, 255, 0.1); padding: 1px 3px; border-radius: 4px; font-size: 1em; line-height: 1.357em;&quot;&gt;optimizer.py&lt;/code&gt;: executa o algoritmo genético e baseline.&lt;/li&gt;&lt;li class=&quot;code-line&quot; dir=&quot;auto&quot;&gt;&lt;code style=&quot;font-family: Menlo, Monaco, &amp;quot;Courier New&amp;quot;, monospace; background-color: rgba(255, 255, 255, 0.1); padding: 1px 3px; border-radius: 4px; font-size: 1em; line-height: 1.357em;&quot;&gt;visualization.py&lt;/code&gt;: gera mapas e gráficos.&lt;/li&gt;&lt;li class=&quot;code-line&quot; dir=&quot;auto&quot;&gt;&lt;code style=&quot;font-family: Menlo, Monaco, &amp;quot;Courier New&amp;quot;, monospace; background-color: rgba(255, 255, 255, 0.1); padding: 1px 3px; border-radius: 4px; font-size: 1em; line-height: 1.357em;&quot;&gt;llm_integration.py&lt;/code&gt;: gera instruções e relatórios.&lt;/li&gt;&lt;li class=&quot;code-line&quot; dir=&quot;auto&quot;&gt;&lt;b&gt;&lt;code style=&quot;font-family: Menlo, Monaco, &amp;quot;Courier New&amp;quot;, monospace; background-color: rgba(255, 255, 255, 0.1); padding: 1px 3px; border-radius: 4px; font-size: 1em; line-height: 1.357em;&quot;&gt;run.py&lt;/code&gt;: orquestra a execução completa.&lt;/b&gt;&lt;/li&gt;&lt;/ol&gt;" vertex="1">
